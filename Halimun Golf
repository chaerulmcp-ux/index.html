<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Halimun Golf Inventory</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SheetJS & jsPDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .transition-smooth { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    <!-- AUTH SCREEN -->
    <div id="auth-screen" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-emerald-900 to-slate-900">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 transition-smooth">
            <div class="text-center mb-6">
                <h1 class="text-2xl font-bold text-slate-900">Halimun Golf Inventory</h1>
                <p class="text-sm text-slate-500 mt-1">Silakan masuk atau daftar dengan email Anda.</p>
            </div>
            <div id="auth-alert" class="hidden mb-4 p-3 rounded-lg text-sm"></div>
            <form id="auth-form" onsubmit="handleAuth(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email Pribadi</label>
                    <input type="email" id="auth-email" required placeholder="nama@email.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Password (Min. 6 karakter)</label>
                    <input type="password" id="auth-password" required placeholder="••••••" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none">
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="submit" class="flex-1 bg-emerald-700 hover:bg-emerald-800 text-white font-medium py-2.5 rounded-xl transition-smooth shadow-lg shadow-emerald-700/20">Login</button>
                    <button type="button" onclick="handleRegister()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium py-2.5 rounded-xl transition-smooth">Daftar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- APP SCREEN -->
    <div id="app-screen" class="hidden min-h-screen flex flex-col md:flex-row">
        <div class="flex-1 p-6 lg:p-8 overflow-y-auto">
            <div class="flex justify-between items-center mb-6">
                <span class="font-bold text-xl text-slate-800">Halimun Golf</span>
                <button onclick="logout()" class="px-4 py-2 bg-red-50 text-red-600 rounded-xl font-medium text-sm hover:bg-red-100 transition-smooth">Keluar</button>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <h2 class="text-xl font-bold mb-4">Dashboard Stok Inventaris</h2>
                <p id="user-info" class="text-slate-600 mb-4"></p>
            </div>
        </div>
    </div>

    <!-- FIREBASE MODULE SCRIPT -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { getFirestore, collection, getDocs, setDoc, doc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCYaufdxJ13jHRMdPpwcX0wAZNzbb1_WME",
            authDomain: "halimun-golf.firebaseapp.com",
            projectId: "halimun-golf",
            storageBucket: "halimun-golf.firebasestorage.app",
            messagingSenderId: "541686898001",
            appId: "1:541686898001:web:75642884390788fb5c4770",
            measurementId: "G-74Z3V0P3CP"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        function showAlert(msg, isError = true) {
            const el = document.getElementById('auth-alert');
            el.className = `mb-4 p-3 rounded-lg text-sm ${isError ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200'}`;
            el.innerText = msg;
            el.classList.remove('hidden');
        }

        window.handleAuth = async function(e) {
            e.preventDefault();
            const email = document.getElementById('auth-email').value;
            const pass = document.getElementById('auth-password').value;
            try {
                await signInWithEmailAndPassword(auth, email, pass);
            } catch (err) {
                showAlert("Login Gagal: " + err.message);
            }
        };

        window.handleRegister = async function() {
            const email = document.getElementById('auth-email').value;
            const pass = document.getElementById('auth-password').value;
            if(!email || !pass) {
                showAlert("Email dan password wajib diisi!");
                return;
            }
            try {
                await createUserWithEmailAndPassword(auth, email, pass);
                showAlert("Pendaftaran berhasil! Silakan klik Login.", false);
            } catch (err) {
                showAlert("Pendaftaran Gagal: " + err.message);
            }
        };

        window.logout = async function() {
            await signOut(auth);
        };

        onAuthStateChanged(auth, (user) => {
            if (user) {
                document.getElementById('auth-screen').classList.add('hidden');
                document.getElementById('app-screen').classList.remove('hidden');
                document.getElementById('user-info').innerText = `Masuk sebagai: ${user.email}`;
            } else {
                document.getElementById('app-screen').classList.add('hidden');
                document.getElementById('auth-screen').classList.remove('hidden');
            }
        });
    </script>
</body>
</html>
