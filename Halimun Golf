<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Halimun Golf - Inventory System</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Chart.js & DataLabels Plugin -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>

    <!-- SheetJS (Excel Export) -->
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
    
    <!-- jsPDF & AutoTable (PDF Export) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

    <!-- Firebase App & SDKs (Compat Version untuk stabilitas web publik) -->
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        .smooth-transition { transition: all 0.3s ease-in-out; }
        .hover-scale:hover { transform: scale(1.02); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
        .pulse-alert { animation: pulse-border 2s infinite; }
        @keyframes pulse-border {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.4s ease-out, padding 0.4s ease; }
        .accordion-content.open { max-height: 2000px; }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Auth Screen -->
    <div id="auth-screen" class="fixed inset-0 bg-slate-900 bg-opacity-50 flex items-center justify-center z-50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 sm:p-8 transform transition-all">
            <div class="text-center mb-6">
                <!-- Halimun Golf Official Logo -->
                <img src="https://raw.githubusercontent.com/chaerulmcp-ux/halimun-golf-inventory/main/Logo%20Flat%20Green_2.png" alt="Halimun Golf Logo" class="h-16 sm:h-20 mx-auto mb-3 object-contain rounded-xl shadow-md" onerror="this.src='https://placehold.co/150x60/10b981/ffffff?text=Halimun+Golf'">
                <h1 class="text-xl font-bold text-slate-800">Halimun Golf Inventory</h1>
                <p class="text-xs text-slate-500 mt-1">Silakan masukkan email pribadi & password untuk login / mendaftar.</p>
            </div>
            
            <form id="auth-form" class="space-y-4" onsubmit="event.preventDefault();">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email Pribadi</label>
                    <input type="email" id="auth-email" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none text-sm" placeholder="email@example.com">
                    <p class="text-[11px] text-slate-400 mt-1">* Catatan Master: email mengandung kata 'master' (cth: master@halimun.com)</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Password (Min. 6 karakter)</label>
                    <input type="password" id="auth-password" required minlength="6" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none text-sm" placeholder="••••••••">
                </div>
                
                <div id="auth-error" class="hidden bg-red-50 text-red-600 text-sm p-3 rounded-lg border border-red-200 text-center"></div>
                <div id="auth-success" class="hidden bg-emerald-50 text-emerald-600 text-sm p-3 rounded-lg border border-emerald-200 text-center"></div>

                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="loginUser()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-lg shadow-md text-sm">Login</button>
                    <button type="button" onclick="registerUser()" class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold py-2.5 rounded-lg text-sm">Daftar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Main App Screen -->
    <div id="app-screen" class="hidden flex-col h-screen overflow-hidden bg-slate-50">
        <nav class="bg-white border-b border-slate-200 shadow-sm z-20 flex-shrink-0">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16 items-center">
                    <div class="flex items-center gap-3">
                        <img src="https://raw.githubusercontent.com/chaerulmcp-ux/halimun-golf-inventory/main/Logo%20Flat%20Green_2.png" class="h-9 sm:h-10 object-contain rounded-lg shadow-sm">
                        <span class="font-bold text-slate-800 text-sm sm:text-base hidden sm:inline">Halimun Golf</span>
                    </div>
                    <div class="flex items-center gap-2 sm:gap-4">
                        <button onclick="openAiModal()" class="bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium hover:bg-emerald-100 flex items-center gap-2 border border-emerald-200">
                            <i class="fa-solid fa-robot"></i> <span class="hidden md:inline">AI Assistant</span>
                        </button>
                        <div class="text-right hidden sm:block">
                            <div id="nav-user-email" class="text-xs sm:text-sm font-bold text-slate-800">user@email.com</div>
                            <div id="nav-user-role" class="text-[10px] sm:text-xs text-emerald-600 uppercase tracking-wider font-bold">Role</div>
                        </div>
                        <button onclick="logoutUser()" class="p-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 text-sm" title="Logout">
                            <i class="fa-solid fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <div class="flex flex-1 overflow-hidden relative">
            <aside class="w-full sm:w-64 bg-white shadow-xl flex-shrink-0 flex sm:flex-col justify-around sm:justify-start fixed sm:relative bottom-0 z-30 border-t sm:border-t-0 sm:border-r border-slate-200 py-1 sm:py-0">
                <div class="sm:p-4 w-full flex sm:flex-col gap-1 sm:gap-2">
                    <button onclick="switchTab('dashboard')" id="tab-dashboard" class="nav-btn flex-1 sm:flex-none flex flex-col sm:flex-row sm:justify-start items-center gap-1 sm:gap-3 p-2 sm:px-4 sm:py-3 rounded-xl text-emerald-700 bg-emerald-50 font-medium text-xs sm:text-sm">
                        <i class="fa-solid fa-chart-pie text-base sm:text-lg"></i> <span>Dashboard</span>
                    </button>
                    <button onclick="switchTab('mutasi')" id="tab-mutasi" class="nav-btn flex-1 sm:flex-none flex flex-col sm:flex-row sm:justify-start items-center gap-1 sm:gap-3 p-2 sm:px-4 sm:py-3 rounded-xl text-slate-500 font-medium text-xs sm:text-sm">
                        <i class="fa-solid fa-exchange-alt text-base sm:text-lg"></i> <span>Mutasi</span>
                    </button>
                    <button onclick="switchTab('barang')" id="tab-barang" class="nav-btn admin-only hidden flex-1 sm:flex-none flex flex-col sm:flex-row sm:justify-start items-center gap-1 sm:gap-3 p-2 sm:px-4 sm:py-3 rounded-xl text-slate-500 font-medium text-xs sm:text-sm">
                        <i class="fa-solid fa-boxes-stacked text-base sm:text-lg"></i> <span>Barang</span>
                    </button>
                    <button onclick="switchTab('laporan')" id="tab-laporan" class="nav-btn flex-1 sm:flex-none flex flex-col sm:flex-row sm:justify-start items-center gap-1 sm:gap-3 p-2 sm:px-4 sm:py-3 rounded-xl text-slate-500 font-medium text-xs sm:text-sm">
                        <i class="fa-solid fa-file-invoice text-base sm:text-lg"></i> <span>Laporan</span>
                    </button>
                    <button onclick="switchTab('users')" id="tab-users" class="nav-btn master-only hidden flex-1 sm:flex-none flex flex-col sm:flex-row sm:justify-start items-center gap-1 sm:gap-3 p-2 sm:px-4 sm:py-3 rounded-xl text-slate-500 font-medium text-xs sm:text-sm">
                        <i class="fa-solid fa-users-gear text-base sm:text-lg"></i> <span>Users</span>
                    </button>
                </div>
            </aside>

            <main class="flex-1 overflow-y-auto p-4 sm:p-6 pb-24 sm:pb-6 relative bg-slate-50" id="main-content">
                <!-- Low Stock Alert Banner -->
                <div id="low-stock-banner" class="hidden mb-6 bg-red-50 border border-red-200 rounded-xl p-4 text-red-800 shadow-sm">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-triangle-exclamation text-red-600 text-xl animate-bounce"></i>
                        <div>
                            <h4 class="font-bold text-sm">Peringatan Stok Minimum!</h4>
                            <p id="low-stock-text" class="text-xs mt-0.5">Beberapa barang berada di bawah batas minimum stock.</p>
                        </div>
                    </div>
                </div>

                <div id="global-date-filter" class="mb-6 bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap gap-4 items-end">
                    <div>
                        <label class="block text-xs font-medium text-slate-500 mb-1">Dari Tanggal</label>
                        <input type="date" id="filter-start" class="px-3 py-2 border rounded-lg text-sm outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-500 mb-1">Sampai Tanggal</label>
                        <input type="date" id="filter-end" class="px-3 py-2 border rounded-lg text-sm outline-none focus:border-emerald-500">
                    </div>
                    <button onclick="applyDateFilter()" class="bg-emerald-100 text-emerald-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-200">Terapkan Filter</button>
                </div>

                <!-- Dashboard View -->
                <div id="view-dashboard" class="tab-view block space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl p-5 text-white shadow-lg hover-scale">
                            <div class="text-emerald-100 text-sm font-medium mb-1">Total Nilai Asset (Range)</div>
                            <div class="text-3xl font-bold" id="dash-total-value">Rp 0</div>
                            <div class="text-sm mt-2 opacity-80" id="dash-total-items">0 Total Barang</div>
                        </div>
                        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm hover-scale flex flex-col justify-between">
                            <div class="text-slate-500 text-sm font-medium mb-1"><i class="fa-solid fa-arrow-trend-up text-emerald-500 mr-2"></i>Paling Banyak Masuk</div>
                            <div id="dash-trend-in" class="text-lg font-bold text-slate-800">-</div>
                        </div>
                        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm hover-scale flex flex-col justify-between">
                            <div class="text-slate-500 text-sm font-medium mb-1"><i class="fa-solid fa-arrow-trend-down text-red-500 mr-2"></i>Paling Banyak Keluar (Expenses)</div>
                            <div id="dash-trend-out" class="text-lg font-bold text-slate-800">-</div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                            <button onclick="toggleAccordion('acc-food')" class="w-full p-5 flex items-center justify-between hover:bg-slate-50 focus:outline-none">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center text-xl"><i class="fa-solid fa-utensils"></i></div>
                                    <div class="text-left">
                                        <h3 class="font-bold text-slate-800">Food</h3>
                                        <p class="text-xs text-slate-500" id="dash-food-count">0 Items</p>
                                    </div>
                                </div>
                                <i class="fa-solid fa-chevron-down text-slate-400 transition-transform duration-300" id="icon-acc-food"></i>
                            </button>
                            <div id="acc-food" class="accordion-content bg-slate-50 border-t border-slate-100 px-4">
                                <div id="list-food" class="py-4 space-y-3"></div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                            <button onclick="toggleAccordion('acc-beverage')" class="w-full p-5 flex items-center justify-between hover:bg-slate-50 focus:outline-none">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xl"><i class="fa-solid fa-wine-glass"></i></div>
                                    <div class="text-left">
                                        <h3 class="font-bold text-slate-800">Beverage</h3>
                                        <p class="text-xs text-slate-500" id="dash-beverage-count">0 Items</p>
                                    </div>
                                </div>
                                <i class="fa-solid fa-chevron-down text-slate-400 transition-transform duration-300" id="icon-acc-beverage"></i>
                            </button>
                            <div id="acc-beverage" class="accordion-content bg-slate-50 border-t border-slate-100 px-4">
                                <div id="list-beverage" class="py-4 space-y-3"></div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                            <button onclick="toggleAccordion('acc-other')" class="w-full p-5 flex items-center justify-between hover:bg-slate-50 focus:outline-none">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center text-xl"><i class="fa-solid fa-box-open"></i></div>
                                    <div class="text-left">
                                        <h3 class="font-bold text-slate-800">Other</h3>
                                        <p class="text-xs text-slate-500" id="dash-other-count">0 Items</p>
                                    </div>
                                </div>
                                <i class="fa-solid fa-chevron-down text-slate-400 transition-transform duration-300" id="icon-acc-other"></i>
                            </button>
                            <div id="acc-other" class="accordion-content bg-slate-50 border-t border-slate-100 px-4">
                                <div id="list-other" class="py-4 space-y-3"></div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm col-span-1 lg:col-span-2">
                            <h3 class="font-bold text-slate-800 mb-4"><i class="fa-solid fa-chart-line text-emerald-500 mr-2"></i>Tren Stock Masuk & Keluar (Kurva Garis Harian)</h3>
                            <div class="relative h-72 w-full"><canvas id="trendChart"></canvas></div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                            <h3 class="font-bold text-slate-800 mb-4"><i class="fa-solid fa-chart-pie text-emerald-500 mr-2"></i>Total Actual Stock & Nilai</h3>
                            <div class="relative h-64 w-full flex justify-center"><canvas id="stockPieChart"></canvas></div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                            <h3 class="font-bold text-slate-800 mb-4"><i class="fa-solid fa-circle-minus text-red-500 mr-2"></i>Total Expenses (Barang Keluar)</h3>
                            <div class="relative h-64 w-full flex justify-center"><canvas id="expensePieChart"></canvas></div>
                        </div>
                    </div>
                </div>

                <!-- Mutasi View -->
                <div id="view-mutasi" class="tab-view hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <h2 class="text-xl font-bold text-slate-800 mb-4">Catat Mutasi Stock</h2>
                        <form id="form-mutasi" class="space-y-4 max-w-2xl" onsubmit="event.preventDefault();">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Kategori Barang</label>
                                    <select id="mut-category" onchange="updateItemDropdown()" required class="w-full px-4 py-2 border rounded-lg outline-none">
                                        <option value="">Pilih Kategori...</option>
                                        <option value="Food">Food</option>
                                        <option value="Beverage">Beverage</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Nama Barang</label>
                                    <select id="mut-item" required class="w-full px-4 py-2 border rounded-lg outline-none disabled:bg-slate-100" disabled>
                                        <option value="">Pilih Kategori Dahulu...</option>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Jenis Mutasi</label>
                                    <select id="mut-type" required class="w-full px-4 py-2 border rounded-lg outline-none">
                                        <option value="in">Masuk (In)</option>
                                        <option value="out">Keluar (Out)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Jumlah</label>
                                    <input type="number" id="mut-qty" required min="1" class="w-full px-4 py-2 border rounded-lg outline-none">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Tanggal</label>
                                    <input type="date" id="mut-date" required class="w-full px-4 py-2 border rounded-lg outline-none">
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Catatan</label>
                                <textarea id="mut-note" rows="2" class="w-full px-4 py-2 border rounded-lg outline-none" placeholder="Keterangan mutasi..."></textarea>
                            </div>
                            <button type="button" onclick="saveMutasi()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-lg shadow font-medium">Simpan Mutasi</button>
                        </form>
                    </div>
                </div>

                <!-- Barang View -->
                <div id="view-barang" class="tab-view hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <h2 class="text-xl font-bold text-slate-800 mb-4">Tambah / Edit Barang</h2>
                        <form id="form-barang" class="space-y-4 max-w-3xl" onsubmit="event.preventDefault();">
                            <input type="hidden" id="item-id">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Nama Barang</label>
                                    <input type="text" id="item-name" required class="w-full px-4 py-2 border rounded-lg outline-none">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Kategori</label>
                                    <select id="item-category" required class="w-full px-4 py-2 border rounded-lg outline-none">
                                        <option value="Food">Food</option>
                                        <option value="Beverage">Beverage</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Harga Satuan (Rp)</label>
                                    <input type="number" id="item-price" required min="0" class="w-full px-4 py-2 border rounded-lg outline-none">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Minimum Stock (Partstock)</label>
                                    <input type="number" id="item-min" required min="0" class="w-full px-4 py-2 border rounded-lg outline-none">
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">URL Gambar Barang</label>
                                <input type="url" id="item-image-url" placeholder="https://..." class="w-full px-4 py-2 border rounded-lg outline-none">
                            </div>
                            <div class="flex gap-2">
                                <button type="button" onclick="saveItem()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-lg shadow font-medium">Simpan Barang</button>
                                <button type="button" onclick="resetItemForm()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-6 py-2 rounded-lg shadow font-medium">Batal / Baru</button>
                            </div>
                        </form>
                    </div>

                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-50 text-slate-600 text-sm border-b border-slate-200">
                                        <th class="px-4 py-3 font-medium">Pic</th>
                                        <th class="px-4 py-3 font-medium">Nama Barang</th>
                                        <th class="px-4 py-3 font-medium">Kategori</th>
                                        <th class="px-4 py-3 font-medium">Harga</th>
                                        <th class="px-4 py-3 font-medium">Min Stock</th>
                                        <th class="px-4 py-3 font-medium">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="table-items" class="divide-y divide-slate-100 text-sm"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Laporan View -->
                <div id="view-laporan" class="tab-view hidden space-y-6">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-wrap justify-between items-center gap-4">
                        <h2 class="text-xl font-bold text-slate-800">Rekap Data Mutasi</h2>
                        <div class="flex gap-2">
                            <button onclick="exportExcel()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg shadow text-sm font-medium"><i class="fa-solid fa-file-excel mr-2"></i>Export Excel</button>
                            <button onclick="exportPDF()" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg shadow text-sm font-medium"><i class="fa-solid fa-file-pdf mr-2"></i>Export PDF</button>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse" id="report-table">
                                <thead>
                                    <tr class="bg-slate-50 text-slate-600 text-sm border-b border-slate-200">
                                        <th class="px-4 py-3 font-medium">Tanggal</th>
