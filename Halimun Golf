    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-20 sm:bottom-6 right-6 bg-slate-800 text-white px-6 py-3 rounded-xl shadow-2xl transform translate-y-24 opacity-0 transition-all duration-300 z-50 flex items-center gap-3">
        <i id="toast-icon" class="fa-solid fa-bell text-emerald-400"></i>
        <span id="toast-msg" class="text-sm font-medium">Notification</span>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, updateDoc, deleteDoc, collection, onSnapshot, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'halimun-golf-inv-01';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            projectId: "demo-project"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        window.appState = {
            user: null,
            items: [],
            mutations: [],
            allUsers: [],
            dateStart: '',
            dateEnd: '',
            charts: { trend: null, pieStock: null, pieExp: null }
        };

        const el = (id) => document.getElementById(id);

        el('item-image-file').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if(!file) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                el('item-image-preview').src = ev.target.result;
                el('item-image-preview').classList.remove('hidden');
                el('item-image-url').value = '';
            };
            reader.readAsDataURL(file);
        });
        el('item-image-url').addEventListener('input', function(e) {
            if(e.target.value) {
                el('item-image-preview').src = e.target.value;
                el('item-image-preview').classList.remove('hidden');
                el('item-image-file').value = '';
            }
        });

        const today = new Date();
        const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        
        const formatDate = (date) => {
            const d = new Date(date);
            let month = '' + (d.getMonth() + 1), day = '' + d.getDate(), year = d.getFullYear();
            if (month.length < 2) month = '0' + month;
            if (day.length < 2) day = '0' + day;
            return [year, month, day].join('-');
        };
        
        el('filter-start').value = formatDate(firstDay);
        el('filter-end').value = formatDate(today);
        
        window.appState.dateStart = formatDate(firstDay);
        window.appState.dateEnd = formatDate(today);

        Chart.register(ChartDataLabels);

        let isAuthReady = false;

        async function initAuth() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
                isAuthReady = true;

                const savedEmail = localStorage.getItem('hg_user_email');
                if(savedEmail) {
                    checkCustomLogin(savedEmail);
                }
            } catch (err) {
                console.error("Auth error:", err);
                showAuthError("Gagal terhubung ke sistem otentikasi.");
            }
        }
        
        initAuth();

        window.login = async () => {
            const email = el('auth-email').value.trim().toLowerCase();
            if(!email) return showAuthError("Email wajib diisi");
            if (!isAuthReady || !auth.currentUser) return showAuthError("Sistem otentikasi belum siap, mohon tunggu sebentar.");

            try {
                const userDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'users', email);
                const userDoc = await getDoc(userDocRef);
                
                if(userDoc.exists()) {
                    const data = userDoc.data();
                    if(data.status === 'pending') {
                        showAuthError("Akun belum disetujui oleh Master Admin.");
                    } else if (data.status === 'rejected') {
                        showAuthError("Akun ditolak.");
                    } else {
                        localStorage.setItem('hg_user_email', email);
                        window.appState.user = data;
                        startApp();
                    }
                } else {
                    showAuthError("Email tidak terdaftar.");
                }
            } catch (error) {
                showAuthError("Error: " + error.message);
            }
        };

        window.register = async () => {
            const email = el('auth-email').value.trim().toLowerCase();
            if(!email) return showAuthError("Email wajib diisi");
            if (!isAuthReady || !auth.currentUser) return showAuthError("Sistem otentikasi belum siap, mohon tunggu sebentar.");

            try {
                const usersColRef = collection(db, 'artifacts', appId, 'public', 'data', 'users');
                const userDocRef = doc(usersColRef, email);
                const userDoc = await getDoc(userDocRef);
                
                if(userDoc.exists()) {
                    showAuthError("Email sudah terdaftar.");
                    return;
                }

                let role = 'staff';
                let status = 'pending';
                if(email.includes('master')) {
                    role = 'master';
                    status = 'approved';
                }

                await setDoc(userDocRef, {
                    email: email,
                    role: role,
                    status: status,
                    createdAt: new Date().toISOString()
                });

                if(status === 'approved') {
                    showAuthSuccess("Berhasil daftar sebagai Master. Silakan Login.");
                } else {
                    showAuthSuccess("Berhasil mendaftar. Menunggu persetujuan Admin.");
                }
            } catch (error) {
                showAuthError("Error: " + error.message);
            }
        };

        window.logout = () => {
            localStorage.removeItem('hg_user_email');
            window.appState.user = null;
            el('app-screen').classList.add('hidden');
            el('auth-screen').classList.remove('hidden');
            el('auth-screen').classList.add('flex');
        };

        function checkCustomLogin(email) {
            const userDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'users', email);
            getDoc(userDocRef).then(docSnap => {
                if(docSnap.exists() && docSnap.data().status === 'approved') {
                    window.appState.user = docSnap.data();
                    startApp();
                } else {
                    localStorage.removeItem('hg_user_email');
                }
            }).catch(e => console.error(e));
        }

        function showAuthError(msg) {
            el('auth-success').classList.add('hidden');
            el('auth-error').textContent = msg;
            el('auth-error').classList.remove('hidden');
        }
        function showAuthSuccess(msg) {
            el('auth-error').classList.add('hidden');
            el('auth-success').textContent = msg;
            el('auth-success').classList.remove('hidden');
        }

        function startApp() {
            el('auth-screen').classList.add('hidden');
            el('auth-screen').classList.remove('flex');
            el('app-screen').classList.remove('hidden');
            el('app-screen').classList.add('flex');

            const u = window.appState.user;
            el('nav-user-email').textContent = u.email;
            el('nav-user-role').textContent = u.role.toUpperCase();

            document.querySelectorAll('.admin-only').forEach(e => e.classList.add('hidden'));
            document.querySelectorAll('.master-only').forEach(e => e.classList.add('hidden'));
            
            if(u.role === 'master' || u.role === 'admin') {
                document.querySelectorAll('.admin-only').forEach(e => e.classList.remove('hidden'));
            }
            if(u.role === 'master') {
                document.querySelectorAll('.master-only').forEach(e => e.classList.remove('hidden'));
                checkAndSeedData();
            }

            el('mut-date').value = formatDate(new Date());

            listenToItems();
            listenToMutations();
            if(u.role === 'master') listenToUsers();
            
            switchTab('dashboard');
        }

        async function checkAndSeedData() {
            if (!auth.currentUser) return;
            try {
                const itemsSnap = await getDocs(collection(db, 'artifacts', appId, 'public', 'data', 'items'));
                if (itemsSnap.empty) {
                    showToast("Memuat Data Dummy Awal...", "fa-spinner");
                    
                    const dummyItems = [
                        { name: "Nasi Goreng Halimun", category: "Food", price: 45000, minStock: 20, imageUrl: "https://images.unsplash.com/photo-1603133872878-684f208fb84b?q=80&w=200&auto=format&fit=crop" },
                        { name: "Sop Buntut", category: "Food", price: 85000, minStock: 15, imageUrl: "https://images.unsplash.com/photo-1543353071-10c8ba85a904?q=80&w=200&auto=format&fit=crop" },
                        { name: "Iced Tea", category: "Beverage", price: 15000, minStock: 50, imageUrl: "https://images.unsplash.com/photo-1556679343-c7306c1976bc?q=80&w=200&auto=format&fit=crop" },
                        { name: "Kopi Susu Gula Aren", category: "Beverage", price: 25000, minStock: 30, imageUrl: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=200&auto=format&fit=crop" },
                        { name: "Golf Ball Titleist", category: "Other", price: 750000, minStock: 10, imageUrl: "https://images.unsplash.com/photo-1587174486073-ae5e5cff23aa?q=80&w=200&auto=format&fit=crop" },
                        { name: "Golf Tees Wooden", category: "Other", price: 50000, minStock: 100, imageUrl: "https://images.unsplash.com/photo-1535131749006-b7f58c99034b?q=80&w=200&auto=format&fit=crop" }
                    ];

                    const d = new Date();
                    const todayStr = formatDate(d);
                    d.setDate(d.getDate() - 2);
                    const pastStr = formatDate(d);

                    for (const item of dummyItems) {
                        const itemRef = await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'items'), {
                            name: item.name,
                            category: item.category,
                            price: item.price,
                            minStock: item.minStock,
                            imageUrl: item.imageUrl
                        });
                        
                        await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'mutations'), {
                            itemId: itemRef.id,
                            type: 'in',
                            qty: item.minStock + 25,
                            date: pastStr,
                            note: 'Initial Stock (System)',
                            timestamp: new Date().getTime(),
                            userId: 'system@halimun.com'
                        });

                        await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'mutations'), {
                            itemId: itemRef.id,
                            type: 'out',
                            qty: 5,
                            date: todayStr,
                            note: 'Penjualan harian',
                            timestamp: new Date().getTime() + 1000,
                            userId: 'system@halimun.com'
                        });
                    }
                    showToast("Data Dummy Berhasil Dimuat", "fa-check");
                }
            } catch (err) {
                console.error("Error seeding data:", err);
            }
        }

        function listenToItems() {
            const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'items');
            onSnapshot(colRef, (snapshot) => {
                window.appState.items = [];
                snapshot.forEach(doc => {
                    window.appState.items.push({ id: doc.id, ...doc.data() });
                });
                renderMasterBarang();
                updateItemDropdown();
                processDashboardData();
            }, (err) => console.error(err));
        }

        function listenToMutations() {
            const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'mutations');
            onSnapshot(colRef, (snapshot) => {
                window.appState.mutations = [];
                snapshot.forEach(doc => {
                    window.appState.mutations.push({ id: doc.id, ...doc.data() });
                });
                processDashboardData();
                renderReports();
                checkLowStockAlerts();
            }, (err) => console.error(err));
        }

        function listenToUsers() {
            const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'users');
            onSnapshot(colRef, (snapshot) => {
                window.appState.allUsers = [];
                snapshot.forEach(doc => {
                    window.appState.allUsers.push({ id: doc.id, ...doc.data() });
                });
                renderUsers();
            }, (err) => console.error(err));
        }

        window.switchTab = (tab) => {
            document.querySelectorAll('.tab-view').forEach(v => v.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(b => {
                b.classList.remove('bg-emerald-50', 'text-emerald-700');
                b.classList.add('text-slate-500');
            });
            
            el('view-' + tab).classList.remove('hidden');
            const activeBtn = el('tab-' + tab);
            if(activeBtn) {
                activeBtn.classList.remove('text-slate-500');
                activeBtn.classList.add('bg-emerald-50', 'text-emerald-700');
            }
            
            if(tab === 'dashboard' || tab === 'laporan') {
                el('global-date-filter').classList.remove('hidden');
                if(tab === 'dashboard') processDashboardData();
            } else {
                el('global-date-filter').classList.add('hidden');
            }
        };

        window.applyDateFilter = () => {
            window.appState.dateStart = el('filter-start').value;
            window.appState.dateEnd = el('filter-end').value;
            processDashboardData();
            renderReports();
            showToast("Filter Tanggal Diterapkan", "fa-check-circle");
        };

        window.showToast = (msg, icon = 'fa-bell', isError = false) => {
            const t = el('toast');
            el('toast-msg').textContent = msg;
            el('toast-icon').className = `fa-solid ${icon} ${isError ? 'text-red-400' : 'text-emerald-400'}`;
            t.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                t.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        };

        const formatRp = (num) => {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(num || 0);
        };

        window.saveItem = async () => {
            const id = el('item-id').value;
            const name = el('item-name').value;
            const cat = el('item-category').value;
            const price = parseInt(el('item-price').value);
            const min = parseInt(el('item-min').value);
            let img = el('item-image-preview').src || '';
            if(img.includes('empty')) img = '';

            if(!name || isNaN(price) || isNaN(min)) return showToast("Mohon lengkapi form", "fa-exclamation-triangle", true);

            const itemData = { name, category: cat, price, minStock: min, imageUrl: img };
            
            try {
                if(id) {
                    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'items', id), itemData);
                    showToast("Barang diupdate");
                } else {
                    await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'items'), itemData);
                    showToast("Barang ditambahkan");
                }
                resetItemForm();
            } catch (e) {
                showToast("Gagal menyimpan", "fa-times", true);
            }
        };

        window.resetItemForm = () => {
            el('item-id').value = '';
            el('item-name').value = '';
            el('item-price').value = '';
            el('item-min').value = '';
            el('item-image-file').value = '';
            el('item-image-url').value = '';
            el('item-image-preview').src = '';
            el('item-image-preview').classList.add('hidden');
        };

        window.editItem = (id) => {
            const item = window.appState.items.find(i => i.id === id);
            if(!item) return;
            el('item-id').value = item.id;
            el('item-name').value = item.name;
            el('item-category').value = item.category;
            el('item-price').value = item.price;
            el('item-min').value = item.minStock;
            if(item.imageUrl) {
                el('item-image-preview').src = item.imageUrl;
                el('item-image-preview').classList.remove('hidden');
            } else {
                el('item-image-preview').src = '';
                el('item-image-preview').classList.add('hidden');
            }
        };

        window.deleteItem = async (id) => {
            if(!confirm("Yakin hapus barang ini?")) return;
            try {
                await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'items', id));
                showToast("Barang dihapus");
            } catch (e) {
                showToast("Gagal hapus", "fa-times", true);
            }
        };

        function renderMasterBarang() {
            const tbody = el('table-items');
            tbody.innerHTML = '';
            window.appState.items.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 smooth-transition';
                tr.innerHTML = `
                    <td class="px-4 py-3"><img src="${item.imageUrl || 'https://placehold.co/100x100/e2e8f0/64748b?text=No+Img'}" class="w-10 h-10 rounded-lg object-cover border"></td>
                    <td class="px-4 py-3 font-medium text-slate-800">${item.name}</td>
                    <td class="px-4 py-3"><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs">${item.category}</span></td>
                    <td class="px-4 py-3">${formatRp(item.price)}</td>
                    <td class="px-4 py-3">${item.minStock}</td>
                    <td class="px-4 py-3">
                        <button onclick="editItem('${item.id}')" class="text-blue-500 hover:text-blue-700 mr-2"><i class="fa-solid fa-edit"></i></button>
                        <button onclick="deleteItem('${item.id}')" class="text-red-500 hover:text-red-700"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        window.updateItemDropdown = () => {
            const cat = el('mut-category').value;
            const select = el('mut-item');
            select.innerHTML = '<option value="">Pilih Barang...</option>';
            if(cat) {
                select.disabled = false;
                window.appState.items.filter(i => i.category === cat).forEach(item => {
                    select.innerHTML += `<option value="${item.id}">${item.name}</option>`;
                });
            } else {
                select.disabled = true;
                select.innerHTML = '<option value="">Pilih Kategori Dahulu...</option>';
            }
        };

        window.saveMutasi = async () => {
            const itemId = el('mut-item').value;
            const type = el('mut-type').value;
            const qty = parseInt(el('mut-qty').value);
            const date = el('mut-date').value;
            const note = el('mut-note').value;

            if(!itemId || !type || isNaN(qty) || !date) return showToast("Mohon lengkapi form", "fa-exclamation-triangle", true);

            const mutData = {
                itemId, type, qty, date, note,
                timestamp: new Date().getTime(),
                userId: window.appState.user.email
            };

            try {
                await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'mutations'), mutData);
                showToast("Mutasi berhasil dicatat");
                el('form-mutasi').reset();
                el('mut-date').value = formatDate(new Date());
                updateItemDropdown();
            } catch (e) {
                showToast("Gagal mencatat mutasi", "fa-times", true);
            }
        };

        function calculateCurrentStocks() {
            let stockMap = {};
            window.appState.items.forEach(i => stockMap[i.id] = 0);
            
            window.appState.mutations.forEach(m => {
                if(stockMap[m.itemId] !== undefined) {
                    if(m.type === 'in') stockMap[m.itemId] += m.qty;
                    else if(m.type === 'out') stockMap[m.itemId] -= m.qty;
                }
            });
            return stockMap;
        }

        let lastNotifiedItems = new Set();
        function checkLowStockAlerts() {
            const stocks = calculateCurrentStocks();
            let lowItems = [];
            window.appState.items.forEach(item => {
                const current = stocks[item.id] || 0;
                if(current < item.minStock) {
                    lowItems.push(item.name);
                    if(!lastNotifiedItems.has(item.id)) {
                        simulateSendEmail(item, current);
                        lastNotifiedItems.add(item.id);
                    }
                } else {
                    lastNotifiedItems.delete(item.id);
                }
            });
        }

        function simulateSendEmail(item, currentQty) {
            console.log(`[MOCK EMAIL SENT] Warning: ${item.name} stock is ${currentQty} (Min: ${item.minStock})`);
            showToast(`EMAIL DIKIRIM: Stock ${item.name} menipis!`, "fa-envelope", true);
        }

        window.toggleAccordion = (id) => {
            const content = el(id);
            const icon = el('icon-' + id);
            if(content.classList.contains('open')) {
                content.classList.remove('open');
                icon.style.transform = 'rotate(0deg)';
            } else {
                content.classList.add('open');
                icon.style.transform = 'rotate(180deg)';
            }
        };

        function processDashboardData() {
            if(window.appState.items.length === 0) return;
            const ds = window.appState.dateStart;
            const de = window.appState.dateEnd;

            const filteredMutations = window.appState.mutations.filter(m => m.date >= ds && m.date <= de);
            const realStocks = calculateCurrentStocks();
            
            renderCategoryList('Food', realStocks);
            renderCategoryList('Beverage', realStocks);
            renderCategoryList('Other', realStocks);

            renderLowStockDashboardAlert(realStocks);

            let rangeValue = 0;
            let rangeItemsCount = 0;
            let actualValuePie = { Food: 0, Beverage: 0, Other: 0 };
            let expenseValuePie = { Food: 0, Beverage: 0, Other: 0 };
            let inCount = {};
            let outCount = {};

            window.appState.items.forEach(item => {
                const stock = realStocks[item.id] || 0;
                rangeValue += (stock * item.price);
                rangeItemsCount += 1;
                actualValuePie[item.category] += (stock * item.price);
            });

            filteredMutations.forEach(m => {
                const item = window.appState.items.find(i => i.id === m.itemId);
                if(item) {
                    if(m.type === 'in') {
                        inCount[item.name] = (inCount[item.name] || 0) + m.qty;
                    } else {
                        outCount[item.name] = (outCount[item.name] || 0) + m.qty;
                        expenseValuePie[item.category] += (m.qty * item.price);
                    }
                }
            });

            el('dash-total-value').textContent = formatRp(rangeValue);
            el('dash-total-items').textContent = `${rangeItemsCount} Jenis Barang (Actual)`;

            const topIn = Object.keys(inCount).sort((a,b) => inCount[b] - inCount[a])[0];
            const topOut = Object.keys(outCount).sort((a,b) => outCount[b] - outCount[a])[0];
            
            el('dash-trend-in').innerHTML = topIn ? `${topIn} <span class="text-sm font-normal text-slate-500">(${inCount[topIn]} item)</span>` : '-';
            el('dash-trend-out').innerHTML = topOut ? `${topOut} <span class="text-sm font-normal text-slate-500">(${outCount[topOut]} item)</span>` : '-';

            buildTrendChart(filteredMutations);
            buildPieCharts(actualValuePie, expenseValuePie);
        }

        function renderCategoryList(cat, stocks) {
            const listEl = el(`list-${cat.toLowerCase()}`);
            let itemsHTML = '';
            let count = 0;
            
            window.appState.items.filter(i => i.category === cat).forEach(item => {
                count++;
                const stock = stocks[item.id] || 0;
                const isLow = stock < item.minStock;
                const alertClass = isLow ? 'bg-red-50 border-red-200 pulse-alert' : 'bg-white border-slate-100';
                const textClass = isLow ? 'text-red-600 font-bold' : 'text-slate-800';
                
                itemsHTML += `
                    <div class="flex items-center justify-between p-3 rounded-lg border ${alertClass} shadow-sm">
                        <div class="flex items-center gap-3">
                            <img src="${item.imageUrl || 'https://placehold.co/100x100/e2e8f0/64748b?text=Img'}" class="w-10 h-10 rounded object-cover border">
                            <div>
                                <div class="text-sm font-bold text-slate-800">${item.name}</div>
                                <div class="text-xs text-slate-500">Min: ${item.minStock} | ${formatRp(item.price)}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-lg ${textClass}">${stock}</div>
                            ${isLow ? '<div class="text-[10px] text-red-500 uppercase font-bold"><i class="fa-solid fa-warning mr-1"></i>Low Stock</div>' : ''}
                        </div>
                    </div>
                `;
            });
            
            if(count === 0) itemsHTML = '<div class="text-center text-sm text-slate-400 py-2">Belum ada barang</div>';
            listEl.innerHTML = itemsHTML;
            el(`dash-${cat.toLowerCase()}-count`).textContent = `${count} Items`;
        }

        function renderLowStockDashboardAlert(stocks) {
            let lowItems = [];
            window.appState.items.forEach(item => {
                const stock = stocks[item.id] || 0;
                if(stock < item.minStock) {
                    lowItems.push({ name: item.name, stock: stock, min: item.minStock, category: item.category });
                }
            });

            let alertBox = el('dash-low-stock-alert-box');
            if(!alertBox) {
                alertBox = document.createElement('div');
                alertBox.id = 'dash-low-stock-alert-box';
                const dashboardView = el('view-dashboard');
                dashboardView.insertBefore(alertBox, dashboardView.children[1]);
            }

            if(lowItems.length > 0) {
                let itemsListHtml = lowItems.map(i => `<li class="flex justify-between items-center py-1 border-b border-red-100 last:border-0"><span><strong>${i.name}</strong> (${i.category})</span> <span class="bg-red-200 text-red-800 px-2 py-0.5 rounded text-xs font-bold">Stok: ${i.stock} / Min: ${i.min}</span></li>`).join('');
                
                alertBox.innerHTML = `
                    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-xl shadow-sm mb-6 pulse-alert">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center gap-2 text-red-700 font-bold">
                                <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                                <span>Peringatan: ${lowItems.length} Barang Berada di Bawah Stock Minimum!</span>
                            </div>
                            <span class="text-xs bg-red-100 text-red-600 px-2.5 py-1 rounded-full font-semibold">Notifikasi Aktif</span>
                        </div>
                        <ul class="text-sm text-slate-700 space-y-1 bg-white p-3 rounded-lg border border-red-200">${itemsListHtml}</ul>
                        <p class="text-xs text-red-500 mt-2">* Email peringatan otomatis telah dikirimkan ke seluruh user yang terdaftar.</p>
                    </div>
                `;
            } else {
                alertBox.innerHTML = '';
            }
        }

        function buildTrendChart(mutations) {
            const ctx = el('trendChart');
            if(!ctx) return;
            
            let dataByDate = {};
            let currD = new Date(window.appState.dateStart);
            let endD = new Date(window.appState.dateEnd);
            while(currD <= endD) {
                let dStr = formatDate(currD);
                dataByDate[dStr] = { in: 0, out: 0, day: currD.getDate() };
                currD.setDate(currD.getDate() + 1);
            }

            mutations.forEach(m => {
                if(dataByDate[m.date]) {
                    if(m.type === 'in') dataByDate[m.date].in += m.qty;
                    if(m.type === 'out') dataByDate[m.date].out += m.qty;
                }
            });

            const labels = Object.keys(dataByDate).sort().map(k => dataByDate[k].day);
            const dataIn = Object.keys(dataByDate).sort().map(k => dataByDate[k].in);
            const dataOut = Object.keys(dataByDate).sort().map(k => dataByDate[k].out);

            if(window.appState.charts.trend) window.appState.charts.trend.destroy();

            window.appState.charts.trend = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Barang Masuk',
                            data: dataIn,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            datalabels: {
                                align: 'top',
                                color: '#10b981',
                                font: { weight: 'bold' },
                                formatter: (val) => val > 0 ? val : ''
                            }
                        },
                        {
                            label: 'Barang Keluar (Expenses)',
                            data: dataOut,
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            datalabels: {
                                align: 'bottom',
                                color: '#ef4444',
                                font: { weight: 'bold' },
                                formatter: (val) => val > 0 ? val : ''
                            }
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        datalabels: { display: true }
                    },
                    scales: {
                        y: { beginAtZero: true },
                        x: { title: { display: true, text: 'Tanggal' } }
                    }
                }
            });
        }

        function buildPieCharts(actualPie, expPie) {
            const ctx1 = el('stockPieChart');
            const ctx2 = el('expensePieChart');
            if(!ctx1 || !ctx2) return;

            const labels = ['Food', 'Beverage', 'Other'];
            const bgColors = ['#f97316', '#3b82f6', '#a855f7'];

            if(window.appState.charts.pieStock) window.appState.charts.pieStock.destroy();
            window.appState.charts.pieStock = new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: [actualPie.Food, actualPie.Beverage, actualPie.Other],
                        backgroundColor: bgColors,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        datalabels: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${formatRp(ctx.raw)}`
                            }
                        }
                    }
                }
            });

            if(window.appState.charts.pieExp) window.appState.charts.pieExp.destroy();
            window.appState.charts.pieExp = new Chart(ctx2, {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: [expPie.Food, expPie.Beverage, expPie.Other],
                        backgroundColor: bgColors,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        datalabels: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${formatRp(ctx.raw)}`
                            }
                        }
                    }
                }
            });
        }

        function renderReports() {
            const ds = window.appState.dateStart;
            const de = window.appState.dateEnd;
            const filtered = window.appState.mutations
                                .filter(m => m.date >= ds && m.date <= de)
                                .sort((a,b) => new Date(b.date) - new Date(a.date));

            const tbody = el('table-reports');
            tbody.innerHTML = '';
            
            filtered.forEach(m => {
                const item = window.appState.items.find(i => i.id === m.itemId);
                const itemName = item ? item.name : 'Unknown Item';
                const cat = item ? item.category : '-';
                const typeStyle = m.type === 'in' ? 'text-emerald-600 bg-emerald-50' : 'text-red-600 bg-red-50';
                const typeText = m.type === 'in' ? 'Masuk' : 'Keluar';

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 smooth-transition">
                        <td class="px-4 py-3">${m.date}</td>
                        <td class="px-4 py-3"><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs">${cat}</span></td>
                        <td class="px-4 py-3 font-medium">${itemName}</td>
                        <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs font-bold ${typeStyle}">${typeText}</span></td>
                        <td class="px-4 py-3 font-bold">${m.qty}</td>
                        <td class="px-4 py-3 text-xs text-slate-500 max-w-xs truncate" title="${m.note}">${m.note || '-'}</td>
                        <td class="px-4 py-3 text-xs text-slate-500">${m.userId}</td>
                    </tr>
                `;
            });
            
            if(filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-slate-500">Tidak ada mutasi di rentang waktu ini.</td></tr>';
            }
        }

        window.exportExcel = () => {
            const wb = XLSX.utils.table_to_book(el('report-table'), {sheet: "Mutasi"});
            XLSX.writeFile(wb, `Rekap_Mutasi_${window.appState.dateStart}_to_${window.appState.dateEnd}.xlsx`);
        };

        window.exportPDF = () => {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            
            doc.setFontSize(16);
            doc.text("Laporan Mutasi Stock - Halimun Golf", 14, 20);
            doc.setFontSize(10);
            doc.text(`Periode: ${window.appState.dateStart} s/d ${window.appState.dateEnd}`, 14, 28);
            
            doc.autoTable({
                html: '#report-table',
                startY: 35,
                theme: 'grid',
                styles: { fontSize: 8 },
                headStyles: { fillColor: [16, 185, 129] }
            });
            
            doc.save(`Laporan_Mutasi_${window.appState.dateStart}_to_${window.appState.dateEnd}.pdf`);
        };

        function renderUsers() {
            const tbody = el('table-users');
            tbody.innerHTML = '';
            window.appState.allUsers.forEach(u => {
                const statusColor = u.status === 'approved' ? 'text-emerald-600 bg-emerald-50' : 
                                   (u.status === 'pending' ? 'text-orange-600 bg-orange-50' : 'text-red-600 bg-red-50');
                
                let actions = '';
                if(u.id !== window.appState.user.email) {
                    if(u.status === 'pending') {
                        actions += `<button onclick="updateUserStatus('${u.id}', 'approved')" class="text-xs bg-emerald-500 text-white px-2 py-1 rounded mr-1">Terima</button>`;
                        actions += `<button onclick="updateUserStatus('${u.id}', 'rejected')" class="text-xs bg-red-500 text-white px-2 py-1 rounded mr-1">Tolak</button>`;
                    } else {
                        actions += `
                            <select onchange="updateUserRole('${u.id}', this.value)" class="text-xs border rounded p-1 mr-1">
                                <option value="staff" ${u.role === 'staff' ? 'selected' : ''}>Staff</option>
                                <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>Admin</option>
                            </select>
                        `;
                        actions += `<button onclick="deleteUser('${u.id}')" class="text-xs bg-red-100 text-red-600 px-2 py-1 rounded"><i class="fa-solid fa-trash"></i></button>`;
                    }
                } else {
                    actions = '<span class="text-xs text-slate-400">Anda (Master)</span>';
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 smooth-transition">
                        <td class="px-4 py-3 font-medium">${u.email}</td>
                        <td class="px-4 py-3 uppercase text-xs font-bold">${u.role}</td>
                        <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs font-bold ${statusColor}">${u.status}</span></td>
                        <td class="px-4 py-3 flex items-center">${actions}</td>
                    </tr>
                `;
            });
        }

        window.updateUserStatus = async (email, status) => {
            try {
                await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'users', email), { status: status });
                showToast("Status user diupdate");
            } catch (e) {
                showToast("Gagal update user", "fa-times", true);
            }
        };

        window.updateUserRole = async (email, role) => {
            try {
                await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'users', email), { role: role });
                showToast("Role user diupdate");
            } catch (e) {
                showToast("Gagal update role", "fa-times", true);
            }
        };

        window.deleteUser = async (email) => {
            if(!confirm(`Hapus user ${email}?`)) return;
            try {
                await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'users', email));
                showToast("User dihapus");
            } catch (e) {
                showToast("Gagal hapus user", "fa-times", true);
            }
        };

        window.openAiModal = () => {
            el('ai-modal').classList.remove('hidden');
        };

        window.closeAiModal = () => {
            el('ai-modal').classList.add('hidden');
        };

        window.sendAiQuery = async () => {
            const inputEl = el('ai-input');
            const query = inputEl.value.trim();
            if(!query) return;

            const chatContainer = el('ai-chat-container');
            
            chatContainer.innerHTML += `
                <div class="flex justify-end">
                    <div class="bg-emerald-600 text-white p-3 rounded-xl max-w-[80%]">${escapeHtml(query)}</div>
                </div>
            `;
            inputEl.value = '';
            chatContainer.scrollTop = chatContainer.scrollHeight;

            const loadingId = 'ai-loading-' + Date.now();
            chatContainer.innerHTML += `
                <div id="${loadingId}" class="flex justify-start">
                    <div class="bg-slate-200 text-slate-700 p-3 rounded-xl flex items-center gap-2">
                        <div class="loader"></div> Sedang menganalisis data inventory...
                    </div>
                </div>
            `;
            chatContainer.scrollTop = chatContainer.scrollHeight;

            try {
                const stocks = calculateCurrentStocks();
                let stockSummary = window.appState.items.map(i => `- ${i.name} (${i.category}): Stock saat ini = ${stocks[i.id] || 0}, Min Stock = ${i.minStock}, Harga = Rp ${i.price}`).join('\n');

                const systemPrompt = "Anda adalah Asisten AI profesional untuk sistem inventaris Halimun Golf Club. Jawablah pertanyaan pengguna berdasarkan data stok riil berikut dengan ringkas, ramah, dan solutif dalam bahasa Indonesia.\n\nData Stok Saat Ini:\n" + stockSummary;

                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const payload = {
                    contents: [{ parts: [{ text: query }] }],
                    systemInstruction: {
                        parts: [{ text: systemPrompt }]
                    }
                };

                let response = null;
                let delay = 1000;
                for (let attempt = 0; attempt < 3; attempt++) {
                    try {
                        response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        if (response.ok) break;
                    } catch (netErr) {
                        if (attempt === 2) throw netErr;
                    }
                    await new Promise(res => setTimeout(res, delay));
                    delay *= 2;
                }

                el(loadingId).remove();

                if (response && response.ok) {
                    const result = await response.json();
                    const candidate = result.candidates?.[0];
                    if (candidate && candidate.content?.parts?.[0]?.text) {
                        const aiText = candidate.content.parts[0].text;
                        chatContainer.innerHTML += `
                            <div class="flex justify-start">
                                <div class="bg-white text-slate-800 border p-3 rounded-xl max-w-[80%] shadow-sm">${escapeHtml(aiText)}</div>
                            </div>
                        `;
                    } else {
                        throw new Error("Invalid AI response structure");
                    }
                } else {
                    throw new Error("API request failed");
                }
            } catch (err) {
                if (el(loadingId)) el(loadingId).remove();
                chatContainer.innerHTML += `
                    <div class="flex justify-start">
                        <div class="bg-red-50 text-red-600 p-3 rounded-xl border border-red-200">Maaf, terjadi kesalahan saat menghubungi AI Assistant.</div>
                    </div>
                `;
            }
            chatContainer.scrollTop = chatContainer.scrollHeight;
        };

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

    </script>
