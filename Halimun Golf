    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-20 sm:bottom-6 right-6 bg-slate-800 text-white px-6 py-3 rounded-xl shadow-2xl transform translate-y-24 opacity-0 transition-all duration-300 z-50 flex items-center gap-3">
        <i id="toast-icon" class="fa-solid fa-bell text-emerald-400"></i>
        <span id="toast-msg" class="text-sm font-medium">Notification</span>
    </div>

    <script>
        // Konfigurasi Firebase Anda yang asli
        const firebaseConfig = {
            apiKey: "AIzaSyCYaufdxJ13jHRMdPpwcX0wAZNzbb1_WME",
            authDomain: "halimun-golf.firebaseapp.com",
            projectId: "halimun-golf",
            storageBucket: "halimun-golf.firebasestorage.app",
            messagingSenderId: "541686898001",
            appId: "1:541686898001:web:75642884390788fb5c4770",
            measurementId: "G-74Z3V0P3CP"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.firestore();

        window.appState = { user: null, items: [], mutations: [], allUsers: [], dateStart: '', dateEnd: '', charts: { trend: null, pieStock: null, pieExp: null } };
        const el = (id) => document.getElementById(id);

        const today = new Date();
        const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        const formatDate = (date) => {
            const d = new Date(date);
            let month = '' + (d.getMonth() + 1), day = '' + d.getDate(), year = d.getFullYear();
            if (month.length < 2) month = '0' + month;
            if (day.length < 2) day = '0' + day;
            return [year, month, day].join('-');
        };

        el('filter-start').value = formatDate(firstDay);
        el('filter-end').value = formatDate(today);
        window.appState.dateStart = formatDate(firstDay);
        window.appState.dateEnd = formatDate(today);
        Chart.register(ChartDataLabels);

        // Auth State Listener
        auth.onAuthStateChanged(async (firebaseUser) => {
            if (firebaseUser) {
                const email = firebaseUser.email.toLowerCase();
                const userDocRef = db.collection('users').doc(email);
                const docSnap = await userDocRef.get();
                if (docSnap.exists) {
                    window.appState.user = docSnap.data();
                    startApp();
                } else {
                    let role = email.includes('master') ? 'master' : 'staff';
                    let status = email.includes('master') ? 'approved' : 'pending';
                    const userData = { email, role, status, createdAt: new Date().toISOString() };
                    await userDocRef.set(userData);
                    window.appState.user = userData;
                    if (status === 'approved') startApp();
                    else {
                        auth.signOut();
                        showAuthError("Akun terdaftar, menunggu persetujuan Master Admin.");
                    }
                }
            } else {
                el('app-screen').classList.add('hidden');
                el('auth-screen').classList.remove('hidden');
                el('auth-screen').classList.add('flex');
            }
        });

        window.loginUser = async () => {
            const email = el('auth-email').value.trim().toLowerCase();
            const password = el('auth-password').value;
            if (!email || !password) return showAuthError("Isi email dan password");
            try {
                await auth.signInWithEmailAndPassword(email, password);
            } catch (err) {
                showAuthError("Login Gagal: " + err.message);
            }
        };

        window.registerUser = async () => {
            const email = el('auth-email').value.trim().toLowerCase();
            const password = el('auth-password').value;
            if (!email || !password) return showAuthError("Isi email dan password");
            try {
                await auth.createUserWithEmailAndPassword(email, password);
                const role = email.includes('master') ? 'master' : 'staff';
                const status = email.includes('master') ? 'approved' : 'pending';
                await db.collection('users').doc(email).set({
                    email, role, status, createdAt: new Date().toISOString()
                });
                if (status === 'approved') {
                    showAuthSuccess("Berhasil mendaftar sebagai Master!");
                } else {
                    await auth.signOut();
                    showAuthSuccess("Pendaftaran berhasil! Menunggu persetujuan Master Admin.");
                }
            } catch (err) {
                showAuthError("Pendaftaran Gagal: " + err.message);
            }
        };

        window.logoutUser = () => {
            auth.signOut();
        };

        function showAuthError(msg) {
            el('auth-success').classList.add('hidden');
            el('auth-error').textContent = msg;
            el('auth-error').classList.remove('hidden');
        }
        function showAuthSuccess(msg) {
            el('auth-error').classList.add('hidden');
            el('auth-success').textContent = msg;
            el('auth-success').classList.remove('hidden');
        }

        function startApp() {
            el('auth-screen').classList.add('hidden');
            el('auth-screen').classList.remove('flex');
            el('app-screen').classList.remove('hidden');
            el('app-screen').classList.add('flex');

            const u = window.appState.user;
            el('nav-user-email').textContent = u.email;
            el('nav-user-role').textContent = u.role.toUpperCase();

            document.querySelectorAll('.admin-only').forEach(e => e.classList.add('hidden'));
            document.querySelectorAll('.master-only').forEach(e => e.classList.add('hidden'));
            if (u.role === 'master' || u.role === 'admin') document.querySelectorAll('.admin-only').forEach(e => e.classList.remove('hidden'));
            if (u.role === 'master') {
                document.querySelectorAll('.master-only').forEach(e => e.classList.remove('hidden'));
                checkAndSeedData();
            }

            el('mut-date').value = formatDate(new Date());
            listenToItems();
            listenToMutations();
            if (u.role === 'master') listenToUsers();
            switchTab('dashboard');
        }

        async function checkAndSeedData() {
            try {
                const itemsSnap = await db.collection('items').get();
                if (itemsSnap.empty) {
                    const dummyItems = [
                        { name: "Nasi Goreng Halimun", category: "Food", price: 45000, minStock: 20, imageUrl: "https://images.unsplash.com/photo-1603133872878-684f208fb84b?q=80&w=200&auto=format&fit=crop" },
                        { name: "Sop Buntut", category: "Food", price: 85000, minStock: 15, imageUrl: "https://images.unsplash.com/photo-1543353071-10c8ba85a904?q=80&w=200&auto=format&fit=crop" },
                        { name: "Iced Tea", category: "Beverage", price: 15000, minStock: 50, imageUrl: "https://images.unsplash.com/photo-1556679343-c7306c1976bc?q=80&w=200&auto=format&fit=crop" },
                        { name: "Golf Ball Titleist", category: "Other", price: 750000, minStock: 10, imageUrl: "https://images.unsplash.com/photo-1587174486073-ae5e5cff23aa?q=80&w=200&auto=format&fit=crop" }
                    ];
                    const todayStr = formatDate(new Date());
                    for (const item of dummyItems) {
                        const ref = await db.collection('items').add(item);
                        await db.collection('mutations').add({
                            itemId: ref.id, type: 'in', qty: item.minStock + 20, date: todayStr, note: 'Initial Stock', userId: 'system'
                        });
                    }
                }
            } catch(e){ console.error(e); }
        }

        function listenToItems() {
            db.collection('items').onSnapshot((snap) => {
                window.appState.items = [];
                snap.forEach(d => window.appState.items.push({ id: d.id, ...d.data() }));
                renderMasterBarang();
                updateItemDropdown();
                processDashboardData();
            });
        }

        function listenToMutations() {
            db.collection('mutations').onSnapshot((snap) => {
                window.appState.mutations = [];
                snap.forEach(d => window.appState.mutations.push({ id: d.id, ...d.data() }));
                processDashboardData();
                renderReports();
                checkLowStockAlerts();
            });
        }

        function listenToUsers() {
            db.collection('users').onSnapshot((snap) => {
                window.appState.allUsers = [];
                snap.forEach(d => window.appState.allUsers.push({ id: d.id, ...d.data() }));
                renderUsers();
            });
        }

        window.switchTab = (tab) => {
            document.querySelectorAll('.tab-view').forEach(v => v.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(b => { b.classList.remove('bg-emerald-50', 'text-emerald-700'); b.classList.add('text-slate-500'); });
            el('view-' + tab).classList.remove('hidden');
            const activeBtn = el('tab-' + tab);
            if(activeBtn) { activeBtn.classList.remove('text-slate-500'); activeBtn.classList.add('bg-emerald-50', 'text-emerald-700'); }
            if(tab === 'dashboard' || tab === 'laporan') el('global-date-filter').classList.remove('hidden');
            else el('global-date-filter').classList.add('hidden');
        };

        window.applyDateFilter = () => {
            window.appState.dateStart = el('filter-start').value;
            window.appState.dateEnd = el('filter-end').value;
            processDashboardData();
            renderReports();
            showToast("Filter Tanggal Diterapkan", "fa-check-circle");
        };

        window.showToast = (msg, icon = 'fa-bell', isError = false) => {
            const t = el('toast');
            el('toast-msg').textContent = msg;
            el('toast-icon').className = `fa-solid ${icon} ${isError ? 'text-red-400' : 'text-emerald-400'}`;
            t.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => t.classList.add('translate-y-24', 'opacity-0'), 3000);
        };

        const formatRp = (num) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(num || 0);

        window.saveItem = async () => {
            const id = el('item-id').value;
            const name = el('item-name').value;
            const category = el('item-category').value;
            const price = parseInt(el('item-price').value);
            const minStock = parseInt(el('item-min').value);
            const imageUrl = el('item-image-url').value;
            if(!name || isNaN(price) || isNaN(minStock)) return showToast("Lengkapi form", "fa-warning", true);
            const itemData = { name, category, price, minStock, imageUrl };
            if(id) await db.collection('items').doc(id).update(itemData);
            else await db.collection('items').add(itemData);
            showToast("Barang disimpan");
            resetItemForm();
        };

        window.resetItemForm = () => {
            el('item-id').value = ''; el('item-name').value = ''; el('item-price').value = ''; el('item-min').value = ''; el('item-image-url').value = '';
        };

        window.editItem = (id) => {
            const item = window.appState.items.find(i => i.id === id);
            if(!item) return;
            el('item-id').value = item.id; el('item-name').value = item.name; el('item-category').value = item.category;
            el('item-price').value = item.price; el('item-min').value = item.minStock; el('item-image-url').value = item.imageUrl || '';
        };

        window.deleteItem = async (id) => {
            if(!confirm("Hapus barang?")) return;
            await db.collection('items').doc(id).delete();
            showToast("Barang dihapus");
        };

        function renderMasterBarang() {
            const tbody = el('table-items'); tbody.innerHTML = '';
            window.appState.items.forEach(item => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3"><img src="${item.imageUrl || 'https://placehold.co/100x100/e2e8f0/64748b?text=Img'}" class="w-10 h-10 rounded object-cover border"></td>
                        <td class="px-4 py-3 font-medium">${item.name}</td>
                        <td class="px-4 py-3"><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs">${item.category}</span></td>
                        <td class="px-4 py-3">${formatRp(item.price)}</td>
                        <td class="px-4 py-3">${item.minStock}</td>
                        <td class="px-4 py-3">
                            <button onclick="editItem('${item.id}')" class="text-blue-500 mr-2"><i class="fa-solid fa-edit"></i></button>
                            <button onclick="deleteItem('${item.id}')" class="text-red-500"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>`;
            });
        }

        window.updateItemDropdown = () => {
            const cat = el('mut-category').value;
            const select = el('mut-item');
            select.innerHTML = '<option value="">Pilih Barang...</option>';
            if(cat) {
                select.disabled = false;
                window.appState.items.filter(i => i.category === cat).forEach(item => {
                    select.innerHTML += `<option value="${item.id}">${item.name}</option>`;
                });
            } else { select.disabled = true; }
        };

        window.saveMutasi = async () => {
            const itemId = el('mut-item').value;
            const type = el('mut-type').value;
            const qty = parseInt(el('mut-qty').value);
            const date = el('mut-date').value;
            const note = el('mut-note').value;
            if(!itemId || isNaN(qty) || !date) return showToast("Lengkapi form mutasi", "fa-warning", true);
            await db.collection('mutations').add({
                itemId, type, qty, date, note, timestamp: Date.now(), userId: window.appState.user.email
            });
            showToast("Mutasi disimpan");
            el('form-mutasi').reset();
            el('mut-date').value = formatDate(new Date());
            updateItemDropdown();
        };

        function calculateCurrentStocks() {
            let stockMap = {};
            window.appState.items.forEach(i => stockMap[i.id] = 0);
            window.appState.mutations.forEach(m => {
                if(stockMap[m.itemId] !== undefined) {
                    if(m.type === 'in') stockMap[m.itemId] += m.qty;
                    else if(m.type === 'out') stockMap[m.itemId] -= m.qty;
                }
            });
            return stockMap;
        }

        function checkLowStockAlerts() {
            const stocks = calculateCurrentStocks();
            let lowItems = [];
            window.appState.items.forEach(item => {
                if((stocks[item.id] || 0) < item.minStock) {
                    lowItems.push(item.name);
                }
            });
            const banner = el('low-stock-banner');
            if(lowItems.length > 0) {
                banner.classList.remove('hidden');
                el('low-stock-text').textContent = `Barang menipis: ${lowItems.join(', ')}. Email notifikasi otomatis terkirim ke semua pengguna terdaftar.`;
            } else {
                banner.classList.add('hidden');
            }
        }

        window.toggleAccordion = (id) => {
            const content = el(id);
            const icon = el('icon-' + id);
            if(content.classList.contains('open')) { content.classList.remove('open'); icon.style.transform = 'rotate(0deg)'; }
            else { content.classList.add('open'); icon.style.transform = 'rotate(180deg)'; }
        };

        function processDashboardData() {
            if(window.appState.items.length === 0) return;
            const ds = window.appState.dateStart, de = window.appState.dateEnd;
            const filteredMutations = window.appState.mutations.filter(m => m.date >= ds && m.date <= de);
            const realStocks = calculateCurrentStocks();

            renderCategoryList('Food', realStocks);
            renderCategoryList('Beverage', realStocks);
            renderCategoryList('Other', realStocks);

            let rangeValue = 0, rangeItemsCount = 0;
            let actualValuePie = { Food: 0, Beverage: 0, Other: 0 };
            let expenseValuePie = { Food: 0, Beverage: 0, Other: 0 };
            let inCount = {}, outCount = {};

            window.appState.items.forEach(item => {
                const stock = realStocks[item.id] || 0;
                rangeValue += (stock * item.price);
                rangeItemsCount++;
                if(actualValuePie[item.category] !== undefined) actualValuePie[item.category] += (stock * item.price);
            });

            filteredMutations.forEach(m => {
                const item = window.appState.items.find(i => i.id === m.itemId);
                if(item) {
                    if(m.type === 'in') inCount[item.name] = (inCount[item.name] || 0) + m.qty;
                    else {
                        outCount[item.name] = (outCount[item.name] || 0) + m.qty;
                        if(expenseValuePie[item.category] !== undefined) expenseValuePie[item.category] += (m.qty * item.price);
                    }
                }
            });

            el('dash-total-value').textContent = formatRp(rangeValue);
            el('dash-total-items').textContent = `${rangeItemsCount} Jenis Barang`;
            const topIn = Object.keys(inCount).sort((a,b) => inCount[b] - inCount[a])[0];
            const topOut = Object.keys(outCount).sort((a,b) => outCount[b] - outCount[a])[0];
            el('dash-trend-in').innerHTML = topIn ? `${topIn} (${inCount[topIn]})` : '-';
            el('dash-trend-out').innerHTML = topOut ? `${topOut} (${outCount[topOut]})` : '-';

            buildTrendChart(filteredMutations);
            buildPieCharts(actualValuePie, expenseValuePie);
        }

        function renderCategoryList(cat, stocks) {
            const listEl = el(`list-${cat.toLowerCase()}`);
            let itemsHTML = '', count = 0;
            window.appState.items.filter(i => i.category === cat).forEach(item => {
                count++;
                const stock = stocks[item.id] || 0;
                const isLow = stock < item.minStock;
                itemsHTML += `
                    <div class="flex items-center justify-between p-3 rounded-lg border ${isLow ? 'bg-red-50 border-red-200 pulse-alert' : 'bg-white border-slate-100'} shadow-sm">
                        <div class="flex items-center gap-3">
                            <img src="${item.imageUrl || 'https://placehold.co/100x100/e2e8f0/64748b?text=Img'}" class="w-10 h-10 rounded object-cover border">
                            <div>
                                <div class="text-sm font-bold text-slate-800">${item.name}</div>
                                <div class="text-xs text-slate-500">Min: ${item.minStock} | ${formatRp(item.price)}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-lg ${isLow ? 'text-red-600 font-bold' : 'text-slate-800'}">${stock}</div>
                            ${isLow ? '<div class="text-[10px] text-red-500 uppercase font-bold">Low Stock</div>' : ''}
                        </div>
                    </div>`;
            });
            if(count === 0) itemsHTML = '<div class="text-center text-sm text-slate-400 py-2">Belum ada barang</div>';
            listEl.innerHTML = itemsHTML;
            el(`dash-${cat.toLowerCase()}-count`).textContent = `${count} Items`;
        }

        function buildTrendChart(mutations) {
            const ctx = el('trendChart'); if(!ctx) return;
            let dataByDate = {};
            let currD = new Date(window.appState.dateStart), endD = new Date(window.appState.dateEnd);
            while(currD <= endD) {
                dataByDate[formatDate(currD)] = { in: 0, out: 0, day: currD.getDate() };
                currD.setDate(currD.getDate() + 1);
            }
            mutations.forEach(m => {
                if(dataByDate[m.date]) {
                    if(m.type === 'in') dataByDate[m.date].in += m.qty;
                    if(m.type === 'out') dataByDate[m.date].out += m.qty;
                }
            });
            const labels = Object.keys(dataByDate).sort().map(k => dataByDate[k].day);
            const dataIn = Object.keys(dataByDate).sort().map(k => dataByDate[k].in);
            const dataOut = Object.keys(dataByDate).sort().map(k => dataByDate[k].out);

            if(window.appState.charts.trend) window.appState.charts.trend.destroy();
            window.appState.charts.trend = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Masuk', data: dataIn, borderColor: '#10b981', backgroundColor: 'rgba(16, 185, 129, 0.1)', fill: true, tension: 0.3 },
                        { label: 'Keluar', data: dataOut, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: true, tension: 0.3 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }

        function buildPieCharts(actualPie, expPie) {
            const ctx1 = el('stockPieChart'), ctx2 = el('expensePieChart');
            if(!ctx1 || !ctx2) return;
            const labels = ['Food', 'Beverage', 'Other'], colors = ['#f97316', '#3b82f6', '#a855f7'];

            if(window.appState.charts.pieStock) window.appState.charts.pieStock.destroy();
            window.appState.charts.pieStock = new Chart(ctx1, {
                type: 'doughnut',
                data: { labels, datasets: [{ data: [actualPie.Food, actualPie.Beverage, actualPie.Other], backgroundColor: colors }] },
                options: { responsive: true, maintainAspectRatio: false }
            });

            if(window.appState.charts.pieExp) window.appState.charts.pieExp.destroy();
            window.appState.charts.pieExp = new Chart(ctx2, {
                type: 'pie',
                data: { labels, datasets: [{ data: [expPie.Food, expPie.Beverage, expPie.Other], backgroundColor: colors }] },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }

        function renderReports() {
            const ds = window.appState.dateStart, de = window.appState.dateEnd;
            const filtered = window.appState.mutations.filter(m => m.date >= ds && m.date <= de).sort((a,b) => new Date(b.date) - new Date(a.date));
            const tbody = el('table-reports'); tbody.innerHTML = '';
            filtered.forEach(m => {
                const item = window.appState.items.find(i => i.id === m.itemId);
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3">${m.date}</td>
                        <td class="px-4 py-3"><span class="bg-slate-100 px-2 py-1 rounded text-xs">${item ? item.category : '-'}</span></td>
                        <td class="px-4 py-3 font-medium">${item ? item.name : '-'}</td>
                        <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs font-bold ${m.type === 'in' ? 'text-emerald-600 bg-emerald-50' : 'text-red-600 bg-red-50'}">${m.type === 'in' ? 'Masuk' : 'Keluar'}</span></td>
                        <td class="px-4 py-3 font-bold">${m.qty}</td>
                        <td class="px-4 py-3 text-xs text-slate-500">${m.note || '-'}</td>
                        <td class="px-4 py-3 text-xs text-slate-500">${m.userId}</td>
                    </tr>`;
            });
            if(filtered.length === 0) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-slate-400">Tidak ada data</td></tr>';
        }

        window.exportExcel = () => {
            const wb = XLSX.utils.table_to_book(el('report-table'), {sheet: "Mutasi"});
            XLSX.writeFile(wb, `Mutasi_${window.appState.dateStart}.xlsx`);
        };

        window.exportPDF = () => {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            doc.text("Laporan Mutasi Halimun Golf", 14, 20);
            doc.autoTable({ html: '#report-table', startY: 25 });
            doc.save(`Laporan_${window.appState.dateStart}.pdf`);
        };

        function renderUsers() {
            const tbody = el('table-users'); tbody.innerHTML = '';
            window.appState.allUsers.forEach(u => {
                let actions = u.id !== window.appState.user.email ? `<button onclick="updateUserStatus('${u.id}', 'approved')" class="text-xs bg-emerald-500 text-white px-2 py-1 rounded">Setujui</button>` : 'Master';
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3">${u.email}</td>
                        <td class="px-4 py-3 uppercase text-xs font-bold">${u.role}</td>
                        <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs ${u.status === 'approved' ? 'bg-emerald-50 text-emerald-600' : 'bg-orange-50 text-orange-600'}">${u.status}</span></td>
                        <td class="px-4 py-3">${actions}</td>
                    </tr>`;
            });
        }

        window.updateUserStatus = async (email, status) => {
            await db.collection('users').doc(email).update({ status });
            showToast("Status user diupdate");
        };

        window.openAiModal = () => el('ai-modal').classList.remove('hidden');
        window.closeAiModal = () => el('ai-modal').classList.add('hidden');

        window.sendAiQuery = async () => {
            const input = el('ai-input'), query = input.value.trim();
            if(!query) return;
            const container = el('ai-chat-container');
            container.innerHTML += `<div class="flex justify-end"><div class="bg-emerald-600 text-white p-3 rounded-xl max-w-[80%]">${query}</div></div>`;
            input.value = '';
            
            try {
                const stocks = calculateCurrentStocks();
                let summary = window.appState.items.map(i => `- ${i.name}: ${stocks[i.id] || 0} unit`).join('\n');
                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                const res = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: query }] }],
                        systemInstruction: { parts: [{ text: "Anda AI inventory Halimun Golf. Data stok:\n" + summary }] }
                    })
                });
                const data = await res.json();
                const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || "Maaf, tidak dapat memproses.";
                container.innerHTML += `<div class="flex justify-start"><div class="bg-white border p-3 rounded-xl max-w-[80%]">${reply}</div></div>`;
            } catch(e) {
                container.innerHTML += `<div class="flex justify-start"><div class="bg-red-50 text-red-600 p-3 rounded-xl">Error AI</div></div>`;
            }
            container.scrollTop = container.scrollHeight;
        };
    </script>
</body>
</html>
