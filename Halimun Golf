    <!-- AI Assistant Modal -->
    <div id="ai-modal" class="fixed inset-0 bg-slate-900 bg-opacity-50 flex items-center justify-center z-50 hidden backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6 flex flex-col h-[500px]">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center"><i class="fa-solid fa-robot"></i></div>
                    <h3 class="font-bold text-slate-800 text-sm sm:text-base">Halimun Golf AI Assistant</h3>
                </div>
                <button onclick="closeAiModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div id="ai-chat-container" class="flex-1 overflow-y-auto space-y-3 p-2 bg-slate-50 rounded-xl border border-slate-100 mb-4 text-sm">
                <div class="bg-emerald-50 text-emerald-800 p-3 rounded-xl border border-emerald-100">Halo! Tanyakan apa saja tentang stok barang Halimun Golf.</div>
            </div>
            <div class="flex gap-2">
                <input type="text" id="ai-input" placeholder="Tanya AI..." class="flex-1 px-4 py-2 border rounded-xl outline-none text-sm" onkeypress="if(event.key === 'Enter') sendAiQuery()">
                <button onclick="sendAiQuery()" class="bg-emerald-600 text-white px-5 py-2 rounded-xl text-sm"><i class="fa-solid fa-paper-plane"></i></button>
